# Generator staging artifacts (the source CSV, and the generated SQL reviewed before
# being copied to seed-sql/). Only matches this dir — seed-sql/*.sql stays tracked.
app/prisma/generators/zt-overlay/*.csv
app/prisma/generators/zt-overlay/*.sql

# Local-only git hooks. commit-msg and pre-push are personal guards; they are not part of the project's tooling contract and are deliberately not shared. pre-commit IS tracked — it runs lint-staged, typecheck and the seed URL gate, and every contributor needs it.
.husky/commit-msg
.husky/pre-push
