# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Authentication
# The app is anonymous unless an OIDC issuer is configured. Setting up sign-in, including
# reaching a SAML identity provider through a bridge, is in docs/runbooks/auth-setup.md.

# Session encryption secret. Required in production, and locally once sign-in is configured.
# Generate with: openssl rand -base64 32. Left empty here so no secret is committed;
# `make setup` (or `make env-auth-secret`) fills it with a random local value.
AUTH_SECRET=""

# Public URL of the app; Auth.js builds its callback URLs from it. This is `make dev`'s port;
# `make dev-debug` and the containers set their own (see the port bands in the Makefile).
# In production with sign-in on, set this or AUTH_TRUST_HOST="true" behind a proxy.
AUTH_URL="http://localhost:3000"

# OIDC sign-in: set all three, or none. A partial set stops startup.
# Register the client at your issuer with the redirect URI <AUTH_URL>/api/auth/callback/oidc
# AUTH_OIDC_ISSUER="https://idp.example.gov"
# AUTH_OIDC_ID=""
# AUTH_OIDC_SECRET=""

# Optional: the provider's name on the sign-in button ("Sign in with <name>")
# AUTH_OIDC_NAME=""

# Optional: "true" puts a sign-in control in the header that goes straight to the issuer.
# Unset, sign-in is reached at /api/auth/signin.
# AUTH_SIGNIN_LINK="true"

# Optional: only these email domains may sign in, comma-separated and matched exactly.
# The issuer must mark the address verified (email_verified). Unset, anyone it signs in is let in.
# AUTH_ALLOWED_EMAIL_DOMAINS="example.gov"

# Optional, with a domain list: accept an address the issuer did not mark verified, for an
# issuer that never sends email_verified. Prefer mapping the claim at the issuer.
# AUTH_ALLOW_UNVERIFIED_EMAIL="true"

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# For local development with Docker database (make db-up)
DATABASE_URL="postgresql://ztdecoder:ztdecoder_dev_password@localhost:5439/zt_decoder_ring_standard"

