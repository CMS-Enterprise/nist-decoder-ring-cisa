  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate && (cd .. && husky || true)",
    "preview": "next build && next start",
    "release": "commit-and-tag-version",
    "release:dry-run": "commit-and-tag-version --dry-run",
    "release:major": "commit-and-tag-version --release-as major",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:patch": "commit-and-tag-version --release-as patch",
    "seed:generate": "tsx prisma/generators/catalog/generate-seed.ts",
    "zt:generate": "tsx prisma/generators/zt-overlay/generate.ts",
    "zt:transform": "tsx prisma/generators/zt-overlay/transform.ts",
    "start": "next start",
    "test": "vitest --project unit",
    "test:coverage": "vitest run --coverage --project unit",
    "test:integration": "vitest run --project integration",
    "test:run": "vitest run --project unit",
    "test:ui": "vitest --ui --project unit",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit"
  },
