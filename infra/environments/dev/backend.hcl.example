# Copy to backend.hcl (gitignored), then: terraform init -backend-config=backend.hcl
# The values are infra/bootstrap's output "environment_backend_config".
bucket       = "<name_prefix>-dev-tfstate-<account_id>-<region>"
key          = "environments/dev/terraform.tfstate"
region       = "<region>"
use_lockfile = true
encrypt      = true
